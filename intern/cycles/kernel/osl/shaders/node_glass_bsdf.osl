#include "node_fresnel.h"
#include "node_math.h"
#include "stdcycles.h"

shader node_glass_bsdf(color Color = 0.8,
                       string distribution = "ggx",
                       int Polarizer = 0,
                       float PolarizerAngle = 0.0,
                       float Roughness = 0.2,
                       float Anisotropy = 0.0,
                       float Rotation = 0.0,
                       float IOR = 1.45,
                       float ThinFilmThickness = 0.0,
                       float ThinFilmIOR = 1.33,
                       float DiffractionWeight = 0.0,
                       float DiffractionPitch = 1600.0,
                       float DiffractionDepth = 150.0,
                       float DiffractionDutyCycle = 0.5,
                       int diffraction_two_sided_handle_plus_one = 0,
                       normal Normal = N,
                       normal Tangent = 0.0,
                       output closure color BSDF = 0)
{
  color base_color = max(Color, color(0.0));
  float alpha = sqr(clamp(Roughness, 0.0, 1.0));
  float eta = max(IOR, 1e-5);
  color F0 = F0_from_ior(eta);
  color F90 = color(1.0);
  float alpha_x, alpha_y;
  float aniso = clamp(Anisotropy, -0.99, 0.99);

  /* rotate tangent around normal */
  vector T = Tangent;

  if (abs(aniso) <= 1e-4) {
    alpha_x = alpha;
    alpha_y = alpha;
  }
  else {
    if (Rotation != 0.0) {
      T = rotate(T, Rotation * M_2PI, point(0.0, 0.0, 0.0), Normal);
    }

    if (aniso < 0.0) {
      alpha_x = alpha / (1.0 + aniso);
      alpha_y = alpha * (1.0 + aniso);
    }
    else {
      alpha_x = alpha * (1.0 - aniso);
      alpha_y = alpha / (1.0 - aniso);
    }
  }

  float grating_weight = clamp(DiffractionWeight, 0.0, 1.0);
  BSDF = (1.0 - grating_weight) * generalized_schlick_bsdf(Normal,
                                  T,
                                  base_color,
                                  base_color,
                                  alpha_x,
                                  alpha_y,
                                  F0,
                                  F90,
                                  -eta,
                                  distribution,
                                  "polarizer", Polarizer,
                                  "polarizer_angle", PolarizerAngle,
                                  "thinfilm_thickness",
                                  ThinFilmThickness,
                                  "thinfilm_ior",
                                  ThinFilmIOR);
  if (grating_weight > 0.0) {
    vector tangent = vector(Tangent) == vector(0.0) ? dPdu : vector(Tangent);
    BSDF += grating_weight * diffraction_glass(Normal, tangent, base_color, Roughness,
        IOR, DiffractionPitch, DiffractionDepth, DiffractionDutyCycle,
        ThinFilmIOR, ThinFilmThickness, distribution == "beckmann",
        "diffraction_two_sided_handle_plus_one", diffraction_two_sided_handle_plus_one,
        "polarizer", Polarizer, "polarizer_angle", PolarizerAngle);
  }
}
